.question-transition-scene {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.transition-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rem;
  padding: 3rem 4rem;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
  max-width: 800px;
}

.transition-text {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  width: 100%;
}

.transition-lang {
  text-align: center;
}

.transition-title {
  font-size: 3.5rem;
  font-weight: 700;
  color: #667eea;
  margin: 0;
  letter-spacing: 1px;
}

.transition-divider {
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.3), transparent);
  margin: 1rem 0;
}
