.sabotage-mcq-answer-scene {
  min-height: 100vh;
  height: 100vh;
  background: linear-gradient(135deg, #1e3a8a 0%, #312e81 50%, #4c1d95 100%);
  color: white;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

/* Animated background effect */
.sabotage-mcq-answer-scene::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.mcq-header {
  text-align: center;
  margin-bottom: 2rem;
  z-index: 1;
}

.phase-title {
  font-size: 2.5rem;
  font-weight: 900;
  margin-bottom: 1.5rem;
  text-shadow: 0 0 20px rgba(59, 130, 246, 0.8),
               0 0 40px rgba(139, 92, 246, 0.6),
               0 4px 8px rgba(0, 0, 0, 0.5);
  letter-spacing: 2px;
  text-transform: uppercase;
  background: linear-gradient(45deg, #3b82f6, #8b5cf6, #fbbf24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sabotage-mcq-answer-scene .team-info h2 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  color: #fbbf24;
  font-weight: 800;
}

.theme-info {
  font-size: 1.5rem;
  margin-bottom: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.theme-type {
  font-size: 1.1rem;
  opacity: 0.9;
  font-style: italic;
  color: #d1d5db;
}

.progress-info {
  font-size: 1.2rem;
  opacity: 0.95;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.question-container {
  max-width: 1200px;
  width: 100%;
  max-height: calc(100vh - 280px);
  overflow-y: auto;
  z-index: 1;
}

.question-text {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.15) 100%);
  backdrop-filter: blur(10px);
  border-radius: 24px;
  padding: 2.5rem;
  margin-bottom: 2rem;
  border: 3px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.question-fr {
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 1rem;
  line-height: 1.4;
  color: white;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
}

.question-nl {
  font-size: 1.8rem;
  opacity: 0.9;
  line-height: 1.4;
  font-weight: 600;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.choices {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.choice {
  display: flex;
  align-items: center;
  gap: 2rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(240, 240, 240, 0.9) 100%);
  color: #1f2937;
  padding: 1.75rem 2rem;
  border-radius: 20px;
  border: 4px solid rgba(156, 163, 175, 0.4);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.5;
}

/* Correct Answer Styling */
.choice.correct {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  border: 5px solid #10b981;
  box-shadow: 0 0 50px rgba(16, 185, 129, 0.8),
              0 0 80px rgba(16, 185, 129, 0.5),
              0 12px 32px rgba(0, 0, 0, 0.4);
  opacity: 1;
  animation: celebrate 0.6s ease-out forwards, glow-correct 2s ease-in-out infinite;
}

@keyframes celebrate {
  0% {
    transform: scale(0.9) rotate(-3deg);
  }
  50% {
    transform: scale(1.12) rotate(3deg);
  }
  100% {
    transform: scale(1.05) rotate(0deg);
  }
}

@keyframes glow-correct {
  0%, 100% {
    box-shadow: 0 0 50px rgba(16, 185, 129, 0.8),
                0 0 80px rgba(16, 185, 129, 0.5),
                0 12px 32px rgba(0, 0, 0, 0.4);
  }
  50% {
    box-shadow: 0 0 70px rgba(16, 185, 129, 1),
                0 0 100px rgba(16, 185, 129, 0.7),
                0 14px 36px rgba(0, 0, 0, 0.4);
  }
}

.choice.correct .choice-letter {
  background: linear-gradient(135deg, #ffffff 0%, #d1fae5 100%);
  color: #065f46;
  box-shadow: 0 0 25px rgba(255, 255, 255, 0.6),
              0 6px 16px rgba(0, 0, 0, 0.3);
  animation: spin-in 0.5s ease-out;
}

@keyframes spin-in {
  from {
    transform: rotate(-180deg) scale(0.5);
    opacity: 0;
  }
  to {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
}

.choice.correct .choice-text {
  color: white;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.choice.correct .choice-nl {
  opacity: 0.95;
}

/* Wrong Answer Styling (when selected) */
.choice.incorrect {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: white;
  border: 5px solid #ef4444;
  box-shadow: 0 0 40px rgba(239, 68, 68, 0.7),
              0 0 60px rgba(239, 68, 68, 0.4),
              0 12px 32px rgba(0, 0, 0, 0.4);
  opacity: 1;
  animation: shake 0.4s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-15px); }
  40% { transform: translateX(15px); }
  60% { transform: translateX(-10px); }
  80% { transform: translateX(10px); }
}

.choice.incorrect .choice-letter {
  background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%);
  color: #fee2e2;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
}

.choice.incorrect .choice-text {
  color: white;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.choice.incorrect .choice-nl {
  opacity: 0.95;
}

.choice-letter {
  font-size: 2.8rem;
  font-weight: 900;
  background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
  color: #f3f4f6;
  width: 75px;
  height: 75px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
  transition: all 0.3s;
}

.choice-text {
  flex: 1;
}

.choice-text > div:first-child {
  font-size: 1.6rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  line-height: 1.4;
}

.choice-nl {
  font-size: 1.3rem;
  opacity: 0.7;
  line-height: 1.4;
  font-weight: 500;
}

.choice-indicator {
  font-size: 3rem;
  font-weight: 900;
  margin-left: auto;
}

.indicator-icon {
  display: inline-block;
}

.choice.correct .indicator-icon {
  color: white;
  animation: bounce-in 0.5s ease-out;
  text-shadow: 0 0 20px rgba(255, 255, 255, 0.8);
}

.choice.incorrect .indicator-icon {
  color: #fee2e2;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
}

@keyframes bounce-in {
  0% {
    transform: translateX(50px) scale(0);
    opacity: 0;
  }
  60% {
    transform: translateX(-5px) scale(1.2);
  }
  100% {
    transform: translateX(0) scale(1);
    opacity: 1;
  }
}

/* Result Banner */
.result-banner {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 24px;
  padding: 2rem 3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  border: 5px solid;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  animation: slide-up-bounce 0.5s ease-out;
}

@keyframes slide-up-bounce {
  0% {
    transform: translateY(150px);
    opacity: 0;
  }
  60% {
    transform: translateY(-15px);
    opacity: 1;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.correct-result {
  border-color: #10b981;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.4) 0%, rgba(5, 150, 105, 0.4) 100%);
  animation: slide-up-bounce 0.5s ease-out, breathing 2s ease-in-out infinite;
}

.incorrect-result {
  border-color: #ef4444;
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.4) 0%, rgba(220, 38, 38, 0.4) 100%);
  animation: slide-up-bounce 0.5s ease-out;
}

@keyframes breathing {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

.result-icon {
  font-size: 3rem;
  animation: spin-scale 0.6s ease-out;
}

@keyframes spin-scale {
  0% {
    transform: rotate(-180deg) scale(0);
  }
  70% {
    transform: rotate(10deg) scale(1.2);
  }
  100% {
    transform: rotate(0deg) scale(1);
  }
}

.result-text {
  font-size: 2.5rem;
  font-weight: 900;
  text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4);
  text-transform: uppercase;
  letter-spacing: 2px;
}

/* Responsive Design */
@media (max-width: 1199px) {
  .phase-title {
    font-size: 2rem;
  }

  .sabotage-mcq-answer-scene .team-info h2 {
    font-size: 2rem;
  }

  .question-fr {
    font-size: 1.8rem;
  }

  .question-nl {
    font-size: 1.5rem;
  }

  .choice-text > div:first-child {
    font-size: 1.4rem;
  }

  .choice-nl {
    font-size: 1.2rem;
  }

  .choice-letter {
    width: 65px;
    height: 65px;
    font-size: 2.4rem;
  }

  .choice-indicator {
    font-size: 2.5rem;
  }

  .result-text {
    font-size: 2rem;
  }

  .result-icon {
    font-size: 2.5rem;
  }
}

@media (max-width: 767px) {
  .sabotage-mcq-answer-scene {
    padding: 1rem;
  }

  .phase-title {
    font-size: 1.5rem;
  }

  .sabotage-mcq-answer-scene .team-info h2 {
    font-size: 1.6rem;
  }

  .theme-info {
    font-size: 1.2rem;
  }

  .progress-info {
    font-size: 1rem;
  }

  .question-text {
    padding: 1.5rem;
    border-width: 3px;
  }

  .question-fr {
    font-size: 1.4rem;
  }

  .question-nl {
    font-size: 1.2rem;
  }

  .choices {
    gap: 1rem;
  }

  .choice {
    padding: 1.25rem 1.5rem;
    gap: 1.25rem;
    border-width: 3px;
  }

  .choice-letter {
    width: 50px;
    height: 50px;
    font-size: 1.8rem;
  }

  .choice-text > div:first-child {
    font-size: 1.2rem;
  }

  .choice-nl {
    font-size: 1rem;
  }

  .choice-indicator {
    font-size: 2rem;
  }

  .result-banner {
    padding: 1.5rem 2rem;
    gap: 1rem;
    border-width: 4px;
  }

  .result-text {
    font-size: 1.5rem;
  }

  .result-icon {
    font-size: 2rem;
  }
}
