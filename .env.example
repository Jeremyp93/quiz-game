# Domain for Traefik routing
DOMAIN=quiz.example.com

# GM Authentication
GM_USERNAME=admin
GM_PASSWORD=ChangeThisSecurePassword123!

# JWT Configuration (REQUIRED)
# Generate a secure key with: openssl rand -base64 32
Jwt__SecretKey=GENERATE_A_SECURE_256_BIT_KEY_HERE_USE_OPENSSL_RAND_BASE64_32

# CORS allowed origins (use your actual domain)
AllowedOrigins=https://quiz.example.com
